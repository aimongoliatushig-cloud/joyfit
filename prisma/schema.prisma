generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  male
  female
  other
}

enum WorkSituation {
  office
  active
  student
  home
  other
}

enum Motivation {
  health
  confidence
  event
  performance
  other
}

enum WeeklyCheckinDay {
  sun
  mon
  tue
  wed
  thu
  fri
  sat
}

enum PlanChoice {
  one_month
  three_months
}

model User {
  id         String   @id @default(cuid())
  phone      String   @unique
  pinHash    String
  inviterRef String?
  createdAt  DateTime @default(now())

  profile Profile?
  weighIns WeighIn[]
}

model Profile {
  id               String           @id @default(cuid())
  userId           String           @unique
  startWeightKg    Float
  targetWeightKg   Float
  heightCm         Int?
  gender           Gender?
  birthYear        Int?
  workSituation    WorkSituation?
  motivation       Motivation?
  weeklyCheckinDay WeeklyCheckinDay?
  planChoice       PlanChoice
  createdAt        DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeighIn {
  id        String   @id @default(cuid())
  userId    String
  weightKg  Float
  imageUrl  String?
  weekKey   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekKey])
  @@index([userId])
  @@index([weekKey])
}
